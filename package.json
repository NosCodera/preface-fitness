{
  "name": "preface-fitness-cloudflare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test:cloudflare": "node --test cloudflare/tests/*.test.mjs",
    "import:browser-backup:prepare": "node cloudflare/scripts/import-browser-backup-relational.mjs",
    "worker:dev": "wrangler --config cloudflare/wrangler.toml dev --local --port 8787",
    "db:migrate:local": "wrangler --config cloudflare/wrangler.toml d1 migrations apply preface-fitness --local --force",
    "db:import:local": "node cloudflare/scripts/import-browser-backup-relational.mjs --backup ./preface-fitness-complete-backup-2026-11-14.json --out ./cloudflare/import-output && node cloudflare/scripts/apply-local-import.mjs",
    "db:seed-owner": "node cloudflare/scripts/seed-local-owner.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^8.3.0",
    "wrangler": "^4.50.0"
  }
}
